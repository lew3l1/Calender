# Supabase > Connect or Project Settings > API Keys.
# This public browser key is safe to expose only when RLS policies are correctly configured.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public VAPID key for Web Push. The private key must never be put in VITE_* variables.
VITE_VAPID_PUBLIC_KEY=