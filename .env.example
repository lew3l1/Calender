# Supabase > Project Settings > API. The anon/publishable key is designed for client use;
# database security must come from the RLS policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public VAPID key for Web Push. The private key must never be put in VITE_* variables.
VITE_VAPID_PUBLIC_KEY=